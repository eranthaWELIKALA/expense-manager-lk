# Copy to .env.local and fill in. Leave blank to run in local demo mode.
# Only VITE_* values are exposed to the browser. The anon key is public by design —
# Row-Level Security in supabase/migrations is what protects data.
# NEVER put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public URL used in invitation links and auth redirects (defaults to window.location.origin).
VITE_APP_URL=

# Server-side only (never VITE_-prefixed): used by `npm run db:migrate`.
# Supabase → Connect → Session pooler connection string, with your DB password.
SUPABASE_DB_URL=
